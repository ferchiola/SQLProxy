<Window x:Class="SQLProxy.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SQLProxy" Height="650" Width="950">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,8">
            <Button x:Name="AddButton" Content="Agregar..." Width="90" Margin="0,0,6,0" Click="AddButton_Click" />
            <Button x:Name="EditButton" Content="Editar..." Width="90" Margin="0,0,6,0" Click="EditButton_Click" />
            <Button x:Name="RemoveButton" Content="Eliminar" Width="90" Margin="0,0,6,0" Click="RemoveButton_Click" />
            <Separator Width="1" Margin="4,0" />
            <Button x:Name="StartButton" Content="Iniciar" Width="90" Margin="12,0,6,0" Click="StartButton_Click" />
            <Button x:Name="StopButton" Content="Detener" Width="90" Margin="0,0,6,0" Click="StopButton_Click" />
        </StackPanel>

        <DataGrid x:Name="ProxyGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nombre" Binding="{Binding Name}" Width="140" />
                <DataGridTextColumn Header="Puerto" Binding="{Binding ListenPort}" Width="70" />
                <DataGridTextColumn Header="Backend" Binding="{Binding BackendType}" Width="120" />
                <DataGridTextColumn Header="Destino" Binding="{Binding Target}" Width="220" />
                <DataGridCheckBoxColumn Header="Auto" Binding="{Binding AutoStart}" Width="50" />
                <DataGridTextColumn Header="Estado" Binding="{Binding Status}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="2" Text="Log:" Margin="0,8,0,4" FontWeight="Bold" />

        <TextBox x:Name="LogBox" Grid.Row="3" IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11" TextWrapping="NoWrap" />
    </Grid>
</Window>
